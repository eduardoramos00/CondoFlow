# ─── Supabase ─────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ─── Email notifications ──────────────────────────────────────────
# Set to "resend" or "postmark"
EMAIL_PROVIDER=resend

# Sender address used by both adapters (e.g. "CondoFlow <noreply@condoflow.pt>")
EMAIL_FROM=CondoFlow <noreply@condoflow.pt>

RESEND_API_KEY=re_<key>
POSTMARK_API_KEY=<key>
# Legacy fallback for Postmark adapter — superseded by EMAIL_FROM when both are set
POSTMARK_FROM_EMAIL=noreply@condoflow.pt

# ─── Notification sweep ───────────────────────────────────────────
# Days after due_date before a PENDING quota is marked OVERDUE (default: 5)
OVERDUE_GRACE_PERIOD_DAYS=5

# ─── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Host/IP adicional permitido em dev (ex.: 192.168.1.50 para testar pela LAN).
# Opcional; deixar vazio se não for necessário.
ALLOWED_DEV_ORIGIN=

# ─── Scripts de seed/demo (opcional) ──────────────────────────────
# Usados apenas pelos scripts em scripts/. Define passwords fortes.
GESTOR_PASSWORD=
CONDOMINO_PASSWORD=
DEMO_PASSWORD=
